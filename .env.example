# === Local / Windows dev ===
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-prod
DB_PATH=temple.db

# === Docker / Oracle VPS (copy to .env and fill in) ===
# SECRET_KEY=replace-with-long-random-string-min-32-chars
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
# DB_PATH=/data/temple.db
# BACKUP_PATH=/data/backups
